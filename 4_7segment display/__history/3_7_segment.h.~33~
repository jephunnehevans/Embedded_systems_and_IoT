#include <16F84A.h>
#use fast_io(a)
#use fast_io(b)
#FUSES XT,NOWDT,PUT,PROTECT
#use delay(crystal=4000000)


#define unit_pin pin_a0
#define tens_pin pin_a1
#define hnds_pin pin_a2
#define thnd_pin pin_a3
#define inc      pin_b7
#define dec      pin_a4

unsigned int8 flag=0;
unsigned int16 counter=9995;

unsigned int8 display(unsigned int8 digit){
unsigned int8 nums[11] = {63,6,91,79,102,109,124,7,127,103};
   return nums[digit];
}

#int_timer0
void isrtimer0(){
unsigned int8 unit=(counter % 10), thnd=(counter / 1000), dis;
unsigned int8 tens=((counter / 10) - ((counter / 100) * 10));
unsigned int8 hnds=((counter / 100) - ((counter / 1000) * 10));
   SET_TIMER0(217);
   flag = (++flag)%4;
   
   if(flag == 3){
      dis = display(unit);
      output_high(unit_pin);
      output_high(tens_pin);
      output_high(hnds_pin);
      output_high(thnd_pin);
      output_b(dis);
      output_low(unit_pin);
   }
   if(flag == 2){
      dis = display(tens);
      output_high(unit_pin);
      output_high(tens_pin);
      output_high(hnds_pin);
      output_high(thnd_pin);
      output_b(dis);
      output_low(tens_pin);
   }
   if(flag == 1){
      dis = display(hnds);
      output_high(unit_pin);
      output_high(tens_pin);
      output_high(hnds_pin);
      output_high(thnd_pin);
      output_b(dis);
      output_low(hnds_pin);
   }
   if(flag == 0){
      dis = display(thnd);
      output_high(unit_pin);
      output_high(tens_pin);
      output_high(hnds_pin);
      output_high(thnd_pin);
      output_b(dis);
      output_low(thnd_pin);
   }
}

void sys_init(){
   output_a(0); output_b(0);
   set_tris_a(0b10000);
   set_tris_b(0b10000000);
   output_a(0); output_b(0);
   
   SETUP_TIMER_0(T0_INTERNAL | T0_DIV_128 | T0_8_BIT);
   SET_TIMER0(217);
   
   CLEAR_INTERRUPT(INT_TIMER0);
   ENABLE_INTERRUPTS(INT_TIMER0);
   ENABLE_INTERRUPTS(GLOBAL);
}


