void trafficLight(unsigned int8 rt, yt, gt, port, rp, yp, gp){
   output_high(port | (1 << rp));
   delay_ms(rt*1000);
   output_high(port & ~(1 << rp));
   
   output_high(port | (1 << yp));
   delay_ms(yt*1000);
   output_high(port & ~(1 << yp));
   
   output_high(port | (1 << gp));
   delay_ms(gt*1000);
   output_high(port & ~(1 << gp));
   
   output_high(port | (1 << yp));
   delay_ms(yt*1000);
   output_high(port & ~(1 << yp));
}

