#include <16F876A.h>
#device ADC=8
#use fast_io(a)
#use fast_io(b)
#use fast_io(c)
#FUSES XT,NOWDT,PUT,NOBROWNOUT,NOLVP,CPD,NOWRT,DEBUG,PROTECT
#use delay(crystal=4000000)

#define LCD_DATA_PORT getenv("SFR:PORTB")
#define LCD_ENABLE_PIN  PIN_B3
#define LCD_RS_PIN      PIN_B1
#define LCD_RW_PIN      PIN_B2
#define LCD_DATA4       PIN_B4
#define LCD_DATA5       PIN_B5
#define LCD_DATA6       PIN_B6
#define LCD_DATA7       PIN_B7
#include "lcd.c"

void sys_init(){
   output_a(0); output_b(0); output_b(0);
   set_tris_a(0b111111); set_tris_b(0); set_tris_c(0);
   output_a(0); output_b(0); output_b(0);
   
   SETUP_CCP1(CCP_PWM);
   SETUP_TIMER_2(T2_DIV_BY_16, 249, 1);
   SET_PWM1_DUTY(249);
   
   lcd_init();
}

