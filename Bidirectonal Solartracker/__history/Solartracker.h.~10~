#include <16F876A.h>
#device ADC=8
#use fast_io(a)
#use fast_io(b)
#use fast_io(c)
#FUSES XT,NOWDT,PUT,NOBROWNOUT,NOLVP,CPD,NOWRT,NODEBUG,PROTECT
#use delay(crystal=4000000)

#define LCD_DATA_PORT getenv("SFR:PORTD")
#define LCD_ENABLE_PIN  PIN_B3
#define LCD_RS_PIN      PIN_B1
#define LCD_RW_PIN      PIN_B2
#define LCD_DATA4       PIN_B4
#define LCD_DATA5       PIN_B5
#define LCD_DATA6       PIN_B6
#define LCD_DATA7       PIN_B7
#include "lcd.c"

#define North_LDR  pin_a0
#define South_LDR  pin_a1
#define East_LDR   pin_a2
#define West_LDR   pin_a3

unsigned int8 c=0, LDRn=0, LDRs=0, LDRe=0, LDRw=0;

void lcd_cls(){
   lcd_putc('\f');
}

void lcd_ln(unsigned int8 l){
   lcd_gotoxy(1, l);
}

void sys_init(){
   output_a(0); output_b(0); output_c(0);
   set_tris_a(0b111111); set_tris_b(0); set_tris_c(0);
   output_a(0); output_b(0); output_c(0);
   
   SETUP_ADC(ADC_CLOCK_INTERNAL);
   SETUP_ADC_PORTS(ALL_ANALOG);
   
   lcd_init(); lcd_cls(); lcd_ln(1);
   lcd_putc("  BIDIRECTIONAL ");
   lcd_ln(2);
   lcd_putc("  SOLAR TRACKER ");
   delay_ms(500);
   
}

