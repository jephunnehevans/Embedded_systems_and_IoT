#include <Lesson 3 _ code 1.h>

void main(){
   output_a(0);
   output_b(0);
   set_tris_a(0b11111);
   set_tris_b(0);
   output_a(0);
   output_b(0);
   
   while(TRUE){
      if(input(pin_a0)){
         output_high(pin_b0);
         delay_ms(1000);
         output_low(pin_b0);
      }
      if(input(pin_a1)){
         output_high(pin_b1);
         delay_ms(1000);
         output_low(pin_b1);
      }
      if(input(pin_a2)){
         output_high(pin_b2);
         delay_ms(1000);
         output_low(pin_b2);
      }
      if(input(pin_a3)){
         output_high(pin_b3);
         delay_ms(1000);
         output_low(pin_b3);
      }
      if(input(pin_a4)){
         output_high(pin_b4);
         delay_ms(1000);
         output_low(pin_b4);
      }
   }

}
