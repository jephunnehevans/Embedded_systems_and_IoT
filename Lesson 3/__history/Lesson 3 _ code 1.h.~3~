#include <16F84A.h>
#FUSES XT,NOWDT,PUT,PROTECT

#use delay(crystal=4000000)

void code1(){
   if(input(pin_a0)){
         output_high(pin_b0);
         delay_ms(1000);
         output_low(pin_b0);
      }
      if(input(pin_a1)){
         output_high(pin_b1);
         delay_ms(1000);
         output_low(pin_b1);
      }
      if(input(pin_a2)){
         output_high(pin_b2);
         delay_ms(1000);
         output_low(pin_b2);
      }
      if(input(pin_a3)){
         output_high(pin_b3);
         delay_ms(1000);
         output_low(pin_b3);
      }
      if(input(pin_a4)){
         output_high(pin_b4);
         delay_ms(1000);
         output_low(pin_b4);
      }
}

