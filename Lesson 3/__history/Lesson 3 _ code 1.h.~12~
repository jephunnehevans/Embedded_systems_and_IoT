      delay_ms(1000);
      output_low(pin_b2);
      }
   else if(w == 0b01000){
      output_high(pin_b3);
      delay_ms(1000);
      output_low(pin_b3);
      }
   else if(w == 0b10000){
      output_high(pin_b4);
      delay_ms(1000);
      output_low(pin_b4);
      }
   else{
   }
}

void code4(){
   w = input_a();
   switch(w){
      case 0b00001:
         output_high(pin_b0);
         delay_ms(1000);
         output_low(pin_b0);
         break;
      case 0b00010:
         output_high(pin_b1);
         delay_ms(1000);
         output_low(pin_b1);
         break;
      case 0b00100:
         output_high(pin_b2);
         delay_ms(1000);
         output_low(pin_b2);
         break;
      case 0b01000:
         output_high(pin_b3);
         delay_ms(1000);
         output_low(pin_b3);
         break;
      case 0b10000:
         output_high(pin_b4);
         delay_ms(1000);
         output_low(pin_b4);
         break;
      default:
         delay_us(1);
         break;
   }
}

