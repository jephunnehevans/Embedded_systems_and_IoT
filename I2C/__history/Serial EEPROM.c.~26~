#include <Serial EEPROM.h>

void main(){
   sys_init();
   loc = make16(read_eeprom(1),read_eeprom(0));
//!   loc = 0;
   while(TRUE){
      temp = READ_ADC();
      delay_ms(100);
      
      lcd_clear(); lcd_line(1);
      printf(lcd_putc "Temp = %u %cC", temp, 223);
      lcd_line(2);
      printf(lcd_putc "Loc = %Lu", loc);
      
      if(input(str_pin)){
         while(input(str_pin));
         lcd_clear(); lcd_line(1);
         printf(lcd_putc "Storing ...");
         i2c_eeprom_write(make8(loc, 1), make8(loc, 0), temp);
         write_eeprom(0, make8(loc, 0));
         delay_ms(100);
         write_eeprom(1, make8(loc, 1));
         delay_ms(100);
         loc++;
      }
      if(input(rcl_pin)){
         while(input(rcl_pin));
         lcd_clear(); lcd_line(1);
         printf(lcd_putc "Reading from");
         lcd_line(2);
         printf(lcd_putc "EEPROM ...");
         delay_ms(2000);
         for(x=loc;x!=0;x--){
            lcd_clear(); lcd_line(1);
            printf(lcd_putc "Temp = %u %cC", i2c_eeprom_read(make8(x-1, 1), make8(x-1, 0)), 223);
            lcd_line(2);
            printf(lcd_putc "Loc = %Lu", x);
            delay_ms(5000);
         }
      }
   }
}
