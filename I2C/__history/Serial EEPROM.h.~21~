void sys_init(){
   output_a(0); output_b(0); output_c(0);
   set_tris_a(0b111111);
   set_tris_b(0); set_tris_c(0b00011011);
   output_a(0); output_b(0); output_c(0);
   
   SETUP_ADC(ADC_CLOCK_INTERNAL);
   SETUP_ADC_PORTS(AN0_AN1_VSS_VREF);
   SET_ADC_CHANNEL(0);
   
   lcd_init(); lcd_putc('\f'); lcd_gotoxy(1,1);
   printf(lcd_putc "   Temperature   ",);
   lcd_gotoxy(1,2);
   printf(lcd_putc "      Logger     ",);
   delay_ms(3000);
}

void i2c_eeprom_write(unsigned int8 addrh, unsigned int8 addrl, char data){
   i2c_start(); //start bit
   i2c_write(0xA0); //chip address + write mode
   i2c_write(addrh); //higher 8-bits
   i2c_write(addrl); //lower 8-bits
   i2c_write(data);  //The data you want to store
   i2c_stop(); //stop bit
   delay_ms(5);
}

char i2c_eeprom_read(unsigned int8 addrh, unsigned int8 addrl){
unsigned int8 var = 0;
   i2c_start();
   i2c_write(0xA0);
   i2c_write(addrh);
   i2c_write(addrl);
   
   i2c_start();
   i2c_write(0xA1);
   
   var = i2c_stop();
   return var;
}

