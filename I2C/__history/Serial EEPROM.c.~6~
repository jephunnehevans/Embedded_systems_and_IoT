#include <Serial EEPROM.h>

void main(){
   sys_init();
   while(TRUE){
      loc = read_eeprom(0);
      temp = READ_ADC();
      delay_ms(10);
      
      lcd_putc('\f');
      lcd_gotoxy(1,1);
      printf(lcd_putc "Temp = %g%cC", temp, 223);
      
      if(input(str_pin)){
         while(input(str_pin));
         i2c_eeprom_write(make8(loc, 1), make8(loc, 0), temp);
         write_eeprom(0, loc);
         loc++
      }
      if(input(rcl_pin)){
         while(input(rcl_pin));
         i2c_eeprom_read(make8(loc, 1), make8(loc, 0));
      }
   }
}
