float dist = 0;

void sys_init(){
   output_a(0); output_b(0); output_c(0);
   set_tris_a(0b111110); set_tris_b(0b10000000); set_tris_c(0);
   output_a(0); output_b(0); output_c(0);
   
   setup_timer_0(T0_INTERNAL | T0_DIV_256 | T0_8_BIT);
   set_timer0(0);
   
   lcd_init(); lcd_putc('\f'); lcd_gotoxy(1,1);
   lcd_putc("  Ultrasonic");
   lcd_gotoxy(1,2);
   lcd_putc("     Meter");
   delay_ms(1000);
}

void Trig(){
   output_high(pin_a1);
   delay_us(10);
   output_low(pin_a1);
}

float Distance_meter(){
float val = 0;
   // while(!input(pin_a0));
   set_Timer0(0);
   while(input(pin_a0));
   val = get_timer0();
   return (((0.034 * val)/2) * 256);
}
