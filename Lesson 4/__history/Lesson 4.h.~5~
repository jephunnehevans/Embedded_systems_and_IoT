#include <16F84A.h>
#FUSES XT,NOWDT,PUT,PROTECT                    //No Watch Dog Timer

#use delay(crystal=4000000)

unsigned int8 count=0;

void method1(){
   if(!input(pin_a0)&&(count<10)){
      while(!input(pin_a0));
      output_b(++count);
   }
   if((input(pin_a1))&&(count>0)){
      while(input(pin_a1));
      output_b(--count);
   }
}

void method2(){
   if(!input(pin_a0)){
      while(!input(pin_a0));
      ++count;
      if(count>10)count=10;
      output_b(count);
   }
   if(input(pin_a1)){
      while(input(pin_a1));
      count--;
      if((count<1)||(count>10))count=0;
      output_b(count);
   }
}

void method3(){
   if(!input(pin_a0)){
      while(!input(pin_a0));
      if(count<255)output_b(++count);
   }
   if(input(pin_a1)){
      while(input(pin_a1));
      if(count>0)output_b(count--);
   }
}



