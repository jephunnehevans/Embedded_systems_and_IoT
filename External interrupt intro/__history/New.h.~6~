#include <16F84A.h>
#use fast_io(a)
#use fast_io(b)
#FUSES XT,NOWDT,PUT,PROTECT
#use delay(crystal=4000000)

//!unsigned int1 trig=0;

#int_ext
void isrext(){
   for(x=0;x<4;x++){
      output_high(pin_a2);
      delay_ms(3000);
      output_low(pin_a2);
      delay_ms(2000);
   }
//!   trig=1;
}

unsigned int8 x=0;

void sys_init(){
   output_a(0);
   output_b(0);
   set_tris_a(0);
   set_tris_b(1);
   output_a(0);
   output_b(0);
   
   clear_interrupt(int_ext);
   enable_interrupts(int_ext);
   ext_int_edge(h_to_l);
   enable_interrupts(global);
   clear_interrupt(int_ext);
}


