012A:  BCF    26.6
012B:  MOVF   26,W
012C:  BSF    03.5
012D:  MOVWF  07
....................    output_drive(LCD_DATA7); 
012E:  BCF    03.5
012F:  BCF    26.7
0130:  MOVF   26,W
0131:  BSF    03.5
0132:  MOVWF  07
....................   #else 
....................    lcdtris.data = 0x0; 
....................   #endif 
....................    lcd_enable_tris(); 
0133:  BCF    03.5
0134:  BCF    26.3
0135:  MOVF   26,W
0136:  BSF    03.5
0137:  MOVWF  07
....................    lcd_rs_tris(); 
0138:  BCF    03.5
