....................  
.................... void lcd_gotoxy(unsigned int8 x, unsigned int8 y) 
.................... { 
....................    unsigned int8 address; 
....................     
....................    if(y!=1) 
*
00C1:  DECFSZ 3F,W
00C2:  GOTO   0C4
00C3:  GOTO   0C7
....................       address=LCD_LINE_TWO; 
00C4:  MOVLW  40
00C5:  MOVWF  40
00C6:  GOTO   0C8
....................    else 
....................       address=0; 
00C7:  CLRF   40
....................       
....................    address+=x-1; 
00C8:  MOVLW  01
00C9:  SUBWF  3E,W
00CA:  ADDWF  40,F
....................    lcd_send_byte(0,0x80|address); 
00CB:  MOVF   40,W
00CC:  IORLW  80
00CD:  MOVWF  41
00CE:  CLRF   42
00CF:  MOVF   41,W
00D0:  MOVWF  43
00D1:  CALL   066
....................  
....................   #if defined(LCD_EXTENDED_NEWLINE) 
00D2:  RETURN
....................    g_LcdX = x - 1; 
....................    g_LcdY = y - 1; 
....................   #endif 
.................... } 
....................  
.................... void lcd_putc(char c) 
.................... { 
....................    switch (c) 
00D3:  MOVF   3D,W
00D4:  XORLW  07
00D5:  BTFSC  03.2
00D6:  GOTO   0E1
00D7:  XORLW  0B
00D8:  BTFSC  03.2
00D9:  GOTO   0E6
00DA:  XORLW  06
00DB:  BTFSC  03.2
00DC:  GOTO   0EE
00DD:  XORLW  02
00DE:  BTFSC  03.2
00DF:  GOTO   0F4
00E0:  GOTO   0F9
....................    { 
....................       case '\a'   :  lcd_gotoxy(1,1);     break; 
00E1:  MOVLW  01
00E2:  MOVWF  3E
00E3:  MOVWF  3F
00E4:  CALL   0C1
00E5:  GOTO   0FE
....................  
....................       case '\f'   :  lcd_send_byte(0,1); 
00E6:  CLRF   42
00E7:  MOVLW  01
00E8:  MOVWF  43
00E9:  CALL   066
....................                      delay_ms(2); 
00EA:  MOVLW  02
00EB:  MOVWF  3E
00EC:  CALL   013
....................                     #if defined(LCD_EXTENDED_NEWLINE) 
....................                      g_LcdX = 0; 
....................                      g_LcdY = 0; 
....................                     #endif 
....................                      break; 
00ED:  GOTO   0FE
....................  
....................      #if defined(LCD_EXTENDED_NEWLINE) 
....................       case '\r'   :  lcd_gotoxy(1, g_LcdY+1);   break; 
....................       case '\n'   : 
....................          while (g_LcdX++ < LCD_LINE_LENGTH) 
....................          { 
....................             lcd_send_byte(1, ' '); 
....................          } 
....................          lcd_gotoxy(1, g_LcdY+2); 
