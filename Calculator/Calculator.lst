013A:  MOVF   26,W
013B:  BSF    03.5
013C:  MOVWF  07
....................    lcd_rw_tris(); 
013D:  BCF    03.5
013E:  BCF    26.2
013F:  MOVF   26,W
0140:  BSF    03.5
0141:  MOVWF  07
....................  #endif 
....................      
....................    delay_ms(15); 
0142:  MOVLW  0F
0143:  BCF    03.5
0144:  MOVWF  3E
0145:  CALL   013
....................    for(i=1;i<=3;++i) 
