void sys_init(){
   output_a(0); output_b(0); output_c(0);
   set_tris_b(0b00001111); set_tris_c(0);
   output_a(0); output_b(0); output_c(0);
   
   PORT_B_PULLUPS(TRUE);
   delay_ms(1000);
   
   lcd_init();
   
   lcd_putc('\f'); lcd_gotoxy(1,1);
   printf(lcd_putc "   Calculator   ");
   delay_ms(500);
}

