#include <main.h>

void main(){
   sys_init();
   while(TRUE) {
      lcd_putc('\f');
      for(x=0;x<3;x++){
         y[x] = scan(!(x%2));
         lcd_gotoxy(1,1);
         printf(lcd_putc "%s", y);
      }
      
      output_b(255);
      output_low(pin_b6);
      for(;;){
         if(!input(pin_b3)){
            while(!input(pin_b3));
            lcd_gotoxy(1,2);
            printf(lcd_putc "= %f", calc(atoi(y[0]), atoi(y[2]), y[1]));
            break;
         }
      }
      
      output_b(255);
      output_low(pin_b4);
      for(;;){
         if(!input(pin_b3)){
            while(!input(pin_b3)); 
            break;
         }
      }
   }
   y = {'\o', '\o', '\o', '\o'}
}
