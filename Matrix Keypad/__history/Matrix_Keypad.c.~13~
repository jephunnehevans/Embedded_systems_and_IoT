#include <Matrix_Keypad.h>

void main(){
   sys_init();
   lcd_putc('\f');
   while(TRUE){
      output_b(255);
      output_low(pin_b4);
      lcd_gotoxy(1, 1);
      if(!input(pin_b0)){
         while(!input(pin_b0));
         lcd_putc('1');
      }
      if(!input(pin_b1)){
         while(!input(pin_b1));
         lcd_putc('4');
      }
      if(!input(pin_b2)){
         while(!input(pin_b2));
         lcd_putc('7');
      }
      if(!input(pin_b3)){
         while(!input(pin_b3));
         lcd_putc('*');
      }
   }
}
