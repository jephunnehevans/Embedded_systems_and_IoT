....................    lcd_output_enable(1); 
0050:  BCF    03.5
0051:  BSF    07.3
0052:  BCF    20.3
0053:  MOVF   20,W
0054:  BSF    03.5
0055:  MOVWF  07
....................    delay_us(2); 
