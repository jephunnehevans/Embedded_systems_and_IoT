void sys_init(){
   output_a(0);
   output_b(0);
   output_c(0);
   set_tris_a(0b111111);
   set_tris_b(0b00000000);
   set_tris_c(0b00000000);
   output_a(0);
   output_b(0);
   output_c(0);
   
   SETUP_ADC(ADC_CLOCK_INTERNAL);
   SETUP_ADC_PORTS(AN0);
   SET_ADC_CHANNEL(0);
   
}

