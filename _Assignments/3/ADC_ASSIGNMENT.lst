.................... #define LCD_DATA_PORT getenv("SFR:PORTD") 
.................... #define LCD_ENABLE_PIN  PIN_C3 
.................... #define LCD_RS_PIN      PIN_C1 
.................... #define LCD_RW_PIN      PIN_C2 
.................... #define LCD_DATA4       PIN_C4 
.................... #define LCD_DATA5       PIN_C5 
