// "ret" is a bool for retuning the set value (here, in BCD) or not
// "given" is an 8 bit binary number NOT BCD
unsigned int8 v=0;
   if(only) RTC_write(0x00, (0b10000000 | RTC_read(0x00))); // halting the oscilation
   
   if(given != 255){ // If we are give the second to set or return, the following will be done
      v = given % 60; // This ensure that it is not not greater than 59 minuites
   }
   else{ // We don't have to manually set if we have been given the second already
