   ////convert all hours to RTC 12hour mode encoding for 0x02 resister
unsigned int8 hoursTo12(unsigned int8 h){
// Takes RTC 0x02 resister BCD and returns RTC 12hour mode encoding for 0x02 resister. "h" MUST BE VALID!!!
   if(!(h & 64)){ // If the input is in 24 hour time
      h = fromBCD(h) % 24; // To curb errors, we ensure that it is not mor than 23 hours
      if(!h) h = 24; // ensure that it is in the range of 1 to 24 (0 = 24)
      
      if(h > 11) return (0b01100000 | toBCD(h - 12)); // for PM
      else return (0b01000000 | toBCD(h)); // for AM
   }
   else return h; // 12 hour time; Note: this does not ensure it is a valid RTC 0x02 resister BCD
}

   ////set hour
unsigned int8 set_hour(unsigned int1 only = 1, ret = 0, unsigned int8 given = 255){
/*This function either returns a set/give value to a variable or writes it to the I2C RTC 0x02 resister
"ret" is a bool for retuning the set value (here, in RTC 12hour mode encoding for 0x02 resister) or not
"given" is an 8 bit binary number NOT BCD*/
unsigned int8 v=0;
   if(only) RTC_write(0x00, (0b10000000 | RTC_read(0x00))); // halting the oscilation
   
   if(given != 255){ // If we are give the hour to set or return, the following will be done
      v = given % 24; // This ensure that it is not not greater than 24 hour
      if(!v) v = 24; // ensure that it is in the range of 1 to 24 (0 = 24)
      v = hoursTo12(toBCD(v)); // Since hoursTo12(v) take only valid RTC 0x02 resister BCD
      
      if(only) RTC_write(0x00, (0b01111111 & RTC_read(0x00))); // playing the oscilation
      if(ret) return v;
      else RTC_write(0x02, v); // writing hour to the RTC
   }
   else{ // seting the hour manually
      //set 12/24 hour
      v = fromBCD(0b01000000 & RTC_read(0x02));//geting present mode
      //changing v to binary
      if(v==0) v=0;
      else v=1;
      //printing as 12 or 24
      lcd_cls(); lcd_ln(1);
      printf(lcd_putc "Set as 12/24Hour");
      lcd_ln(2);
      if(v) printf(lcd_putc "12");
      else  printf(lcd_putc "24");
      //Alowing to set 12 or 24 mode
      while(!input(pin_a4) && !ret){
         if(input(pin_a3)){ //for increasing
            while(input(pin_a3));
            v++;
         }
         if(input(pin_a5)){ //for decreasing
            while(input(pin_a5));
            v--;
         }
         v %= 2;
         lcd_cls(); lcd_ln(1);
         printf(lcd_putc "Set as 12/24Hour");
         lcd_ln(2);
         if(v) printf(lcd_putc "12");
         else  printf(lcd_putc "24");
         delay_ms(50);
      }
      while(input(pin_a4));
      
      //if it is in 12 hour mode
      if(v || ret){//Setting AM/PM
         v = fromBCD(0b00100000 & RTC_read(0x02));
         //chaning v to binary
         if(v==0) v=0;
         else v=1;
         //printing the binary
         lcd_cls(); lcd_ln(1);
         printf(lcd_putc "Set as AM/PM");
         lcd_ln(2);
         if(v) printf(lcd_putc "PM");
         else  printf(lcd_putc "AM");
         //Alow to set AM or PM
         while(!input(pin_a4)){
            if(input(pin_a3)){ //for increasing
               while(input(pin_a3));
               v++;
            }
            if(input(pin_a5)){ //for decreasing
               while(input(pin_a5));
               v--;
            }
            v %= 2;
            lcd_cls(); lcd_ln(1);
            printf(lcd_putc "Set as AM/PM");
            lcd_ln(2);
            if(v) printf(lcd_putc "PM");
            else  printf(lcd_putc "AM");
            delay_ms(50);
         }
         while(input(pin_a4));
         //seting the hour
         if(v){//if it is PM
            v = fromBCD(0b00011111 & RTC_read(0x02));
            lcd_cls(); lcd_ln(1);
            printf(lcd_putc "Set Hour");
            lcd_ln(2);
            printf(lcd_putc "%u", v);
            while(!input(pin_a4)){
               if(input(pin_a3)){ //for increasing
                  while(input(pin_a3));
                  v++;
               }
               if(input(pin_a5)){ //for decreasing
                  while(input(pin_a5));
                  v--;
               }
               v %= 12;
               if(v==0) v=12;
               lcd_cls(); lcd_ln(1);
               printf(lcd_putc "Set Hour");
               lcd_ln(2);
               printf(lcd_putc "%u", v);
               delay_ms(50);
            }
            while(input(pin_a4));
            v = (0b01100000 | toBCD(v)); // RTC register coded
            if(only) RTC_write(0x00, (0b01111111 & RTC_read(0x00))); // playing the oscilation
            if(ret) return v;
            else RTC_write(0x02, v); // writing hour to the RTC
         }
         else{ //if it is AM
            v = fromBCD(0b00011111 & RTC_read(0x02));
            lcd_cls(); lcd_ln(1);
            printf(lcd_putc "Set Hour");
            lcd_ln(2);
            printf(lcd_putc "%u", v);
            while(!input(pin_a4)){
               if(input(pin_a3)){ //for increasing
                  while(input(pin_a3));
                  v++;
               }
               if(input(pin_a5)){ //for decreasing
                  while(input(pin_a5));
                  v--;
               }
               v %= 12;
               if(v==0) v=12;
               lcd_cls(); lcd_ln(1);
               printf(lcd_putc "Set Hour");
               lcd_ln(2);
               printf(lcd_putc "%u", v);
               delay_ms(50);
            }
            while(input(pin_a4));
            v = (0b01000000 | toBCD(v)); // RTC register coded
            if(only) RTC_write(0x00, (0b01111111 & RTC_read(0x00))); // playing the oscilation
            if(ret) return v;
            else RTC_write(0x02, v); // writing hour to the RTC
         }
      }
      else{//for 24 hour Mode
         v = fromBCD(0b00111111 & RTC_read(0x02));
         lcd_cls(); lcd_ln(1);
         printf(lcd_putc "Set Hour");
         lcd_ln(2);
         printf(lcd_putc "%u", v);
         while(!input(pin_a4)){
            if(input(pin_a3)){ //for increasing
               while(input(pin_a3));
               v++;
            }
            if(input(pin_a5)){ //for decreasing
               while(input(pin_a5));
               v--;
            }
            v %= 24;
            lcd_cls(); lcd_ln(1);
            printf(lcd_putc "Set Hour");
            lcd_ln(2);
            printf(lcd_putc "%u", v);
            delay_ms(50);
         }
         while(input(pin_a4));
         
         RTC_write(0x02, (0 | toBCD(v))); // writing hour to the RTC
         if(only) RTC_write(0x00, (0b01111111 & RTC_read(0x00))); // playing the oscilation
      }
   }
}

   ////set All time
void set_time(unsigned int8 h=255, m=255, s=255){
   RTC_write(0x00, (0b10000000 | RTC_read(0x00)));
   
   set_hour(0, given=h);
   set_minute(0, given=m);
   set_second(0, given=s);
   
   RTC_write(0x00, (0b01111111 & RTC_read(0x00)));
}

   ////convert all hours to 24 hour
unsigned int8 hoursTo24(unsigned int8 h){
// Takes BCD and returns BCD, therefore it has to ba a valid BCD number
   if(h & 64){// 12 hour time
      if(h & 32) return toBCD((fromBCD(0b00011111 & h) + 12) % 24);// for PM
      else return (0b00011111 & h);// for AM
   }
   else return h;// 24 hour time; Note: this does not ensure it is a valid BCD number
}

   ////compare and Array of time {min, hour, "terminator"} with the current time
unsigned int1 compare_time_with_RTC(unsigned int8 arr[3]){
// Takes an array of unsigned int8 and returns True or False
unsigned int8 h=0, m=0;
   h = fromBCD(hoursTo24(RTC_read(0x02)));
   m = fromBCD(RTC_read(0x01));
   if(arr[1]==h){
      if(arr[0]==m) return true;
   }
   return false; // else is not used so that no matter which of the two conditions in the nested loop that is false, it will return something
}

