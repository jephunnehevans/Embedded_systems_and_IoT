void lcd_cls(){
   lcd_putc('\f');
}

void lcd_ln(unsigned int8 l){
   lcd_gotoxy(1, l);
}

unsigned int8 toBCD(unsigned int8 num){
   return ((num/10 << 4) | (num%10));
}

unsigned int8 fromBCD(unsigned int8 num){
   return ((((0b11110000 & num) >> 4) * 10) + (0b00001111 & num));
}


void RTC_write(unsigned int8 addr, data){
   i2c_start();
   i2c_write(0xD0);
   i2c_write(addr);
   i2c_write(data);
   i2c_stop();
   delay_ms(5);
}

unsigned int8 RTC_read(unsigned int8 addr){
unsigned int8 var = 0;
   i2c_start();
   i2c_write(0xD0);
   i2c_write(addr);
   
   i2c_start();
   i2c_write(0xD1);
   
   var = i2c_read(0);
   delay_ms(5);
   i2c_stop();
   return var;
}

void print_time(){
unsigned int8 h=0, m=0, s=0;
   h = RTC_read(0x02);
   m = fromBCD(RTC_read(0x01));
   s = fromBCD(RTC_read(0x00) & 0b01111111);
   if(h & 64){ // 12 hour time
      if(h & 32){ // PM
         h = fromBCD(0b00011111 & h);
         printf(lcd_putc "%u:%u:%u PM", h, m, s);
      }
      else{ // AM
         h = fromBCD(0b00011111 & h);
         printf(lcd_putc "%u:%u:%u AM", h, m, s);
      }
   }
   else{ // 24 hour time
      h = fromBCD(h);
      printf(lcd_putc "%u:%u:%u", h, m, s);
   }
}

   ////set seconds
unsigned int8 set_second(unsigned int1 only = 1, ret = 0, unsigned int8 given = 255){
// "ret" is a bool for retuning the set value (here, in BCD) or not
// "given" is an 8 bit binary number NOT BCD
unsigned int8 v=0;
   if(only) RTC_write(0x00, (0b10000000 | RTC_read(0x00))); // halting the oscilation
   
   if(given != 255){ // If we are give the second to set or return, the following will be done
      v = given % 60; // This ensure that it is not not greater than 59 seconds
   }
   else{ // We don't have to manually set if we have been given the second already
      v = (0b01111111 & RTC_read(0x00));
      lcd_cls(); lcd_ln(1);
      printf(lcd_putc "Set Second");
      lcd_ln(2);
      printf(lcd_putc "%u", v);
      while(!input(pin_a4)){
         if(input(pin_a3)){ //for increasing
            while(input(pin_a3));
            v++;
         }
         if(input(pin_a5)){ //for decreasing
            while(input(pin_a5));
            v--;
         }
         v %= 60;
         lcd_cls(); lcd_ln(1);
         printf(lcd_putc "Set Second");
         lcd_ln(2);
         printf(lcd_putc "%u", v);
         delay_ms(50);
      }
      while(input(pin_a4));
   }
   v = toBCD(v);
   if(only) RTC_write(0x00, (0b01111111 & v)); // when we are setting only second
   if(ret) return v; // if we need to return the value - to a variable or parse it in a function
   else if(!only) RTC_write(0x00, (0b10000000 | v)); /* this last stage is essential since we are
   not retuning the value, we know the funtion should not be useless so we conclude the reason why
   the fuction was used was to set second and other time variables ...
## Some thing is been done per case
   only | ret |                what is done                  |                        for what?
   -----------------------------------------------------------------------------------------------------------------
     0  |  0  | RTC_write(0x00, (0b10000000 | v))            | setting the seconds and leaving the oscilation pause
     0  |  1  | return v                                     | returning the value to a variable
     1  |  0  | RTC_write(0x00, (0b01111111 & v))            | setting the seconds and playing the oscilation
     1  |  1  | RTC_write(0x00, (0b01111111 & v)), return v  | setting the seconds and playing the oscilation, then returning the value to a variable
   */
}

