   ////set hour
unsigned int8 set_hour(unsigned int1 only = 1, ret = 0){
unsigned int8 v=0;
   if(only) RTC_write(0x00, (0b10000000 | RTC_read(0x00)));
   
   ///set 12/24 hour
   v = fromBCD(0b01000000 & RTC_read(0x02));//geting present mode
   //changing v to binary
   if(v==0) v=0;
   else v=1;
   //printing as 12 or 24
   lcd_cls(); lcd_ln(1);
   printf(lcd_putc "Set as 12/24Hour");
   lcd_ln(2);
   if(v) printf(lcd_putc "12");
   else  printf(lcd_putc "24");
   //Alowing to set 12 or 24 mode
   while(!input(pin_a4)){
      if(input(pin_a3)){ //for increasing
         while(input(pin_a3));
         v++;
      }
      if(input(pin_a5)){ //for decreasing
         while(input(pin_a5));
         v--;
      }
      v %= 2;
      lcd_cls(); lcd_ln(1);
      printf(lcd_putc "Set as 12/24Hour");
      lcd_ln(2);
      if(v) printf(lcd_putc "12");
      else  printf(lcd_putc "24");
      delay_ms(50);
   }
   while(input(pin_a4));
   
   //if it is in 12 hour mode
   if(v){//Setting AM/PM
      v = fromBCD(0b00100000 & RTC_read(0x02));
      //chaning v to binary
      if(v==0) v=0;
      else v=1;
      //printing the binary
      lcd_cls(); lcd_ln(1);
      printf(lcd_putc "Set as AM/PM");
      lcd_ln(2);
      if(v) printf(lcd_putc "PM");
      else  printf(lcd_putc "AM");
      //Alow to set AM or PM
      while(!input(pin_a4)){
         if(input(pin_a3)){ //for increasing
            while(input(pin_a3));
            v++;
         }
         if(input(pin_a5)){ //for decreasing
            while(input(pin_a5));
            v--;
         }
         v %= 2;
         lcd_cls(); lcd_ln(1);
         printf(lcd_putc "Set as AM/PM");
         lcd_ln(2);
         if(v) printf(lcd_putc "PM");
         else  printf(lcd_putc "AM");
         delay_ms(50);
      }
      while(input(pin_a4));
      //seting the hour
      if(v){//if it is PM
         v = fromBCD(0b00011111 & RTC_read(0x02));
         lcd_cls(); lcd_ln(1);
         printf(lcd_putc "Set Hour");
         lcd_ln(2);
         printf(lcd_putc "%u", v);
         while(!input(pin_a4)){
            if(input(pin_a3)){ //for increasing
               while(input(pin_a3));
               v++;
            }
            if(input(pin_a5)){ //for decreasing
               while(input(pin_a5));
               v--;
            }
            v %= 12;
            if(v==0) v=12;
            lcd_cls(); lcd_ln(1);
            printf(lcd_putc "Set Hour");
            lcd_ln(2);
            printf(lcd_putc "%u", v);
            delay_ms(50);
         }
         while(input(pin_a4));
         
         if(only) RTC_write(0x00, (0b01111111 & RTC_read(0x00)));
         if(ret) return (v | 0b11000000);
         else RTC_write(0x02, (0b01100000 | toBCD(v)));
      }
      else{ //if it is AM
         v = fromBCD(0b00011111 & RTC_read(0x02));
         lcd_cls(); lcd_ln(1);
         printf(lcd_putc "Set Hour");
         lcd_ln(2);
         printf(lcd_putc "%u", v);
         while(!input(pin_a4)){
            if(input(pin_a3)){ //for increasing
               while(input(pin_a3));
               v++;
            }
            if(input(pin_a5)){ //for decreasing
               while(input(pin_a5));
               v--;
            }
            v %= 12;
            if(v==0) v=12;
            lcd_cls(); lcd_ln(1);
            printf(lcd_putc "Set Hour");
            lcd_ln(2);
            printf(lcd_putc "%u", v);
            delay_ms(50);
         }
         while(input(pin_a4));
         
         if(only) RTC_write(0x00, (0b01111111 & RTC_read(0x00)));
         if(ret) return (v | 0b10000000);
         else RTC_write(0x02, (0b01000000 | toBCD(v)));
      }
   }
   else{//for 24 hour Mode
      v = fromBCD(0b00111111 & RTC_read(0x02));
      lcd_cls(); lcd_ln(1);
      printf(lcd_putc "Set Hour");
      lcd_ln(2);
      printf(lcd_putc "%u", v);
      while(!input(pin_a4)){
         if(input(pin_a3)){ //for increasing
            while(input(pin_a3));
            v++;
         }
         if(input(pin_a5)){ //for decreasing
            while(input(pin_a5));
            v--;
         }
         v %= 24;
         lcd_cls(); lcd_ln(1);
         printf(lcd_putc "Set Hour");
         lcd_ln(2);
         printf(lcd_putc "%u", v);
         delay_ms(50);
      }
      while(input(pin_a4));
      
      if(only) RTC_write(0x00, (0b01111111 & RTC_read(0x00)));
      if(ret) return v;
      else RTC_write(0x02, (0 | toBCD(v)));
   }
}

   ////set All time
void set_time(){
   RTC_write(0x00, (0b10000000 | RTC_read(0x00)));
   
   set_hour(0);
   set_minute(0);
   set_second(0);
   
   RTC_write(0x00, (0b01111111 & RTC_read(0x00)));
}

