unsigned int8 hr = 0, mn = 0, sc = 0;

void lcd_cls(){
   lcd_putc('\f');
}

void lcd_ln(unsigned int8 l){
   lcd_gotoxy(1, l);
}

unsigned int8 toBCD(unsigned int8 num){
   return ((num/10 << 4) | (num%10));
}

unsigned int8 fromBCD(unsigned int8 num){
   return ((((0b11110000 & num) >> 4) * 10) + (0b00001111 & num));
}


void RTC_write(unsigned int8 addr, data){
   i2c_start();
   i2c_write(0xD0);
   i2c_write(addr);
   i2c_write(data);
   i2c_stop();
   delay_ms(5);
}

unsigned int8 RTC_read(unsigned int8 addr){
unsigned int8 var = 0;
   i2c_start();
   i2c_write(0xD0);
   i2c_write(addr);
   
   i2c_start();
   i2c_write(0xD1);
   
   var = i2c_read(0);
   delay_ms(5);
   i2c_stop();
   return var;
}

void print_time(){
unsigned int8 h=0, m=0, s=0;
   h = RTC_read(0x02);
   m = fromBCD(RTC_read(0x01));
   s = fromBCD(RTC_read(0x00) & 0b01111111);
   if(h & 0b01000000){
      if(h & 0b00100000){
         h = fromBCD(0b00011111 & h);
         printf(lcd_putc "%u:%u:%u PM", h, m, s);
      }
      else{
         h = fromBCD(0b00011111 & h);
         printf(lcd_putc "%u:%u:%u AM", h, m, s);
      }
   }
   else{
      h = fromBCD(h);
      printf(lcd_putc "%u:%u:%u", h, m, s);
   }
}

   ////set seconds
unsigned int8 set_second(unsigned int1 only = 1, ret = 0){
unsigned int8 v=0;
   if(only) RTC_write(0x00, (0b10000000 | RTC_read(0x00)));
   v = fromBCD(0b01111111 & RTC_read(0x00));
   lcd_cls(); lcd_ln(1);
   printf(lcd_putc "Set Second");
   lcd_ln(2);
   printf(lcd_putc "%u", v);
   while(!input(pin_a4)){
      if(input(pin_a3)){ //for increasing
         while(input(pin_a3));
         v++;
      }
      if(input(pin_a5)){ //for decreasing
         while(input(pin_a5));
         v--;
      }
      v %= 60;
      lcd_cls(); lcd_ln(1);
      printf(lcd_putc "Set Second");
      lcd_ln(2);
      printf(lcd_putc "%u", v);
      delay_ms(50);
   }
   while(input(pin_a4));
   if(only) v = (0b01111111 & v);
   
   if(ret) return v;
   else RTC_write(0x00, toBCD(v));
}

