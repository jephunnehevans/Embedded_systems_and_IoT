#define LCD_DATA5       PIN_B5
#define LCD_DATA6       PIN_B6
#define LCD_DATA7       PIN_B7
#include "lcd.c"

unsigned int8 c = 0;

unsigned int8 toBCD(unsigned int8 num){
   return ((num/10 << 4) | (num%10));
}

unsigned int8 fromBCD(unsigned int8 num){
   return ((((0b11110000 & num) >> 4) * 10) + (0b00001111 & num));
}


void RTC_write(unsigned int8 addr, data){
   i2c_start();
   i2c_write(0xD0);
   i2c_write(addr);
   i2c_write(data);
   i2c_stop();
   delay_ms(5);
}

void lcd_cls(){
   lcd_putc('\f');
}

void lcd_ln(unsigned int8 l){
   lcd_gotoxy(1, l);
}

void sys_init(){
   output_a(0); output_b(0); output_c(0);
   set_tris_a(0b111111); set_tris_b(0); set_tris_c(0);
   output_a(0); output_b(0); output_c(0);
   
   lcd_init();
}

unsigned int8 RTC_read(unsigned int8 addr){
unsigned int8 var = 0;
   i2c_start();
   i2c_write(0xD0);
   i2c_write(addr);
   
   i2c_start();
   i2c_write(0xD1);
   
   var = i2c_read(0);
   delay_ms(5);
   return var;
}

   ////set seconds
void set_second(unsigned int1 only = 1){
unsigned int8 v=0;
   if(only) RTC_write(0x00, (0b10000000 | RTC_read(0x00)));
   v = fromBCD(0b01111111 & RTC_read(0x00));
   lcd_cls(); lcd_ln(1);
   printf(lcd_putc "Set Second");
   lcd_ln(2);
   printf(lcd_putc "%u", v);
   while(!input(pin_a4)){
      if(input(pin_a3)){ //for increasing
         while(input(pin_a3));
         v++;
      }
      if(input(pin_a5)){ //for decreasing
         while(input(pin_a5));
         v--;
      }
      v %= 60;
      lcd_cls(); lcd_ln(1);
      printf(lcd_putc "Set Second");
      lcd_ln(2);
      printf(lcd_putc "%u", v);
   }
   if(only) RTC_write(0x00, (0b01111111 & v));
}

   ////set minutes
void set_minute(unsigned int1 only = 1){
unsigned int8 v=0;
   if(only) RTC_write(0x00, (0b10000000 | RTC_read(0x00)));
   v = fromBCD(RTC_read(0x01));
   lcd_cls(); lcd_ln(1);
   printf(lcd_putc "Set Minute");
   lcd_ln(2);
   printf(lcd_putc "%u", v);
   while(!input(pin_a4)){
      if(input(pin_a3)){ //for increasing
         while(input(pin_a3));
         v++;
      }
      if(input(pin_a5)){ //for decreasing
         while(input(pin_a5));
         v--;
      }
      v %= 60;
      lcd_cls(); lcd_ln(1);
      printf(lcd_putc "Set Minute");
      lcd_ln(2);
      printf(lcd_putc "%u", v);
   }
   RTC_write(0x01, toBCD(v));
   
   if(only) RTC_write(0x00, (0b01111111 & RTC_read(0x00)));
}

void set_hour(unsigned int1 only = 1){
unsigned int8 v=0;
   if(only) RTC_write(0x00, (0b10000000 | RTC_read(0x00)));
   
   ////set hour
   
   ///set 12/24 hour
   v = fromBCD(0b01000000 & RTC_read(0x02));//geting present mode
   //changing v to binary
   if(v==0) v=0;
   else v=1;
   //printing as 12 or 24
   lcd_cls(); lcd_ln(1);
   printf(lcd_putc "Set as 12/24Hour");
   lcd_ln(2);
   if(v) printf(lcd_putc "12");
   else  printf(lcd_putc "24");
   //Alowing to set 12 or 24 mode
   while(!input(pin_a4)){
      if(input(pin_a3)){ //for increasing
         while(input(pin_a3));
         v++;
      }
      if(input(pin_a5)){ //for decreasing
         while(input(pin_a5));
         v--;
      }
      v %= 2;
      lcd_cls(); lcd_ln(1);
      printf(lcd_putc "Set as 12/24Hour");
      lcd_ln(2);
      if(v) printf(lcd_putc "12");
      else  printf(lcd_putc "24");
   }
   
   //if it is in 12 hour mode
   if(v){//Setting AM/PM
      v = fromBCD(0b00100000 & RTC_read(0x02));
      //chaning v to binary
      if(v==0) v=0;
      else v=1;
      //printing the binary
      lcd_cls(); lcd_ln(1);
      printf(lcd_putc "Set as AM/PM");
      lcd_ln(2);
      if(v) printf(lcd_putc "PM");
      else  printf(lcd_putc "AM");
      //Alow to set AM or PM
      while(!input(pin_a4)){
         if(input(pin_a3)){ //for increasing
            while(input(pin_a3));
            v++;
         }
         if(input(pin_a5)){ //for decreasing
            while(input(pin_a5));
            v--;
         }
         v %= 2;
         lcd_cls(); lcd_ln(1);
         printf(lcd_putc "Set as AM/PM");
         lcd_ln(2);
         if(v) printf(lcd_putc "PM");
         else  printf(lcd_putc "AM");
      }
      //seting the hour
      if(v){//if it is PM
         v = fromBCD(0b00011111 & RTC_read(0x02));
         lcd_cls(); lcd_ln(1);
         printf(lcd_putc "Set Hour");
         lcd_ln(2);
         printf(lcd_putc "%u", v);
         while(!input(pin_a4)){
            if(input(pin_a3)){ //for increasing
               while(input(pin_a3));
               v++;
            }
            if(input(pin_a5)){ //for decreasing
               while(input(pin_a5));
               v--;
            }
            v %= 12;
            if(v==0) v=12;
            lcd_cls(); lcd_ln(1);
            printf(lcd_putc "Set Hour");
            lcd_ln(2);
            printf(lcd_putc "%u", v);
         }
         RTC_write(0x02, 0b01100000 | toBCD(v));
      }
      else{ //if it is AM
         v = fromBCD(0b00011111 & RTC_read(0x02));
         lcd_cls(); lcd_ln(1);
         printf(lcd_putc "Set Hour");
         lcd_ln(2);
         printf(lcd_putc "%u", v);
         while(!input(pin_a4)){
            if(input(pin_a3)){ //for increasing
               while(input(pin_a3));
               v++;
            }
            if(input(pin_a5)){ //for decreasing
               while(input(pin_a5));
               v--;
            }
            v %= 12;
            if(v==0) v=12;
            lcd_cls(); lcd_ln(1);
            printf(lcd_putc "Set Hour");
            lcd_ln(2);
            printf(lcd_putc "%u", v);
         }
         RTC_write(0x02, 0b01000000 | toBCD(v));
      }
   }
   else{//for 24 hour Mode
      v = fromBCD(0b00111111 & RTC_read(0x02));
      lcd_cls(); lcd_ln(1);
      printf(lcd_putc "Set Hour");
      lcd_ln(2);
      printf(lcd_putc "%u", v);
      while(!input(pin_a4)){
         if(input(pin_a3)){ //for increasing
            while(input(pin_a3));
            v++;
         }
         if(input(pin_a5)){ //for decreasing
            while(input(pin_a5));
            v--;
         }
         v %= 24;
         lcd_cls(); lcd_ln(1);
         printf(lcd_putc "Set Hour");
         lcd_ln(2);
         printf(lcd_putc "%u", v);
      }
      RTC_write(0x02, 0 | toBCD(v));
   }
   if(only) RTC_write(0x00, (0b01111111 & RTC_read(0x00)));
}

