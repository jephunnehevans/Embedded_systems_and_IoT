....................    ////set day 
.................... void set_day(unsigned int1 only = 1){ 
.................... unsigned int8 v=0; 
....................    if(only) RTC_write(0x00, (0b10000000 | RTC_read(0x00))); 
....................    v = fromBCD(RTC_read(0x03)); 
....................    lcd_cls(); lcd_ln(1); 
....................    printf(lcd_putc "Set day"); 
....................    lcd_ln(2); 
....................    printf(lcd_putc "%u", v); 
....................    while(!input(pin_a4)){ 
....................       if(input(pin_a3)){ //for increasing 
....................          while(input(pin_a3)); 
....................          v++; 
....................       } 
....................       if(input(pin_a5)){ //for decreasing 
....................          while(input(pin_a5)); 
....................          v--; 
....................       } 
....................       v %= 7; 
....................       if(v==0) v=7; 
....................       lcd_cls(); lcd_ln(1); 
....................       printf(lcd_putc "Set day"); 
....................       lcd_ln(2); 
....................       printf(lcd_putc "%u", v); 
....................    } 
....................    while(input(pin_a4)); 
....................    RTC_write(0x03, toBCD(v)); 
....................     
....................    if(only) RTC_write(0x00, (0b01111111 & RTC_read(0x00))); 
.................... } 
....................  
....................    ////set date 
.................... void set_date(unsigned int1 no_days=31, only = 1){ 
.................... unsigned int8 v=0; 
....................    if(only) RTC_write(0x00, (0b10000000 | RTC_read(0x00))); 
....................    v = fromBCD(RTC_read(0x04)); 
....................    lcd_cls(); lcd_ln(1); 
....................    printf(lcd_putc "Set Date"); 
....................    lcd_ln(2); 
....................    printf(lcd_putc "%u", v); 
....................    while(!input(pin_a4)){ 
....................       if(input(pin_a3)){ //for increasing 
....................          while(input(pin_a3)); 
....................          v++; 
....................       } 
....................       if(input(pin_a5)){ //for decreasing 
....................          while(input(pin_a5)); 
....................          v--; 
....................       } 
....................       v %= no_days; 
....................       if(v==0) v=no_days; 
....................       lcd_cls(); lcd_ln(1); 
....................       printf(lcd_putc "Set Date"); 
....................       lcd_ln(2); 
....................       printf(lcd_putc "%u", v); 
....................       delay_ms(50); 
....................    } 
....................    while(input(pin_a4)); 
....................    RTC_write(0x04, toBCD(v)); 
....................     
....................    if(only) RTC_write(0x00, (0b01111111 & RTC_read(0x00))); 
.................... } 
....................  
....................    ////set month 
.................... void set_month(unsigned int1 only = 1){ 
.................... unsigned int8 v=0; 
....................    if(only) RTC_write(0x00, (0b10000000 | RTC_read(0x00))); 
....................    v = fromBCD(RTC_read(0x05)); 
....................    lcd_cls(); lcd_ln(1); 
....................    printf(lcd_putc "Set Month"); 
....................    lcd_ln(2); 
....................    printf(lcd_putc "%u", v); 
....................    while(!input(pin_a4)){ 
....................       if(input(pin_a3)){ //for increasing 
....................          while(input(pin_a3)); 
....................          v++; 
....................       } 
....................       if(input(pin_a5)){ //for decreasing 
....................          while(input(pin_a5)); 
....................          v--; 
....................       } 
....................       v %= 12; 
....................       lcd_cls(); lcd_ln(1); 
....................       printf(lcd_putc "Set Month"); 
....................       lcd_ln(2); 
....................       printf(lcd_putc "%u", v); 
....................       delay_ms(50); 
....................    } 
....................    while(input(pin_a4)); 
....................    RTC_write(0x05, toBCD(v)); 
....................     
....................    if(only) RTC_write(0x00, (0b01111111 & RTC_read(0x00))); 
.................... } 
....................  
....................    ////set year 
.................... void set_year(unsigned int1 only = 1){ 
.................... unsigned int8 v=0; 
....................    if(only) RTC_write(0x00, (0b10000000 | RTC_read(0x00))); 
....................    v = fromBCD(RTC_read(0x01)); 
....................    lcd_cls(); lcd_ln(1); 
....................    printf(lcd_putc "Set Year"); 
....................    lcd_ln(2); 
....................    printf(lcd_putc "%u", v); 
....................    while(!input(pin_a4)){ 
....................       if(input(pin_a3)){ //for increasing 
....................          while(input(pin_a3)); 
....................          v++; 
....................       } 
....................       if(input(pin_a5)){ //for decreasing 
....................          while(input(pin_a5)); 
....................          v--; 
....................       } 
....................       v %= 99; 
....................       lcd_cls(); lcd_ln(1); 
....................       printf(lcd_putc "Set Year"); 
....................       lcd_ln(2); 
....................       printf(lcd_putc "%u", v); 
....................       delay_ms(50); 
....................    } 
....................    while(input(pin_a4)); 
....................    RTC_write(0x01, toBCD(v)); 
....................     
....................    if(only) RTC_write(0x00, (0b01111111 & RTC_read(0x00))); 
.................... } 
