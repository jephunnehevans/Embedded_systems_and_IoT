....................  
....................    ////convert all hours to RTC 12hour mode encoding for 0x02 resister 
.................... unsigned int8 hoursTo12(unsigned int8 h){ 
.................... // Takes RTC 0x02 resister BCD and returns RTC 12hour mode encoding for 0x02 resister. "h" MUST BE VALID!!! 
....................    if(!(h & 64)){ // If the input is in 24 hour time 
*
039C:  BTFSC  3A.6
039D:  GOTO   3C3
....................       h = fromBCD(h) % 24; // To curb errors, we ensure that it is not mor than 23 hours 
039E:  MOVF   3A,W
039F:  MOVWF  3B
03A0:  CALL   213
03A1:  MOVF   78,W
03A2:  MOVWF  3E
03A3:  MOVLW  18
03A4:  MOVWF  3F
03A5:  CALL   1EC
03A6:  MOVF   77,W
03A7:  MOVWF  3A
....................       if(!h) h = 24; // ensure that it is in the range of 1 to 24 (0 = 24) 
03A8:  MOVF   3A,F
03A9:  BTFSS  03.2
03AA:  GOTO   3AD
03AB:  MOVLW  18
03AC:  MOVWF  3A
....................        
....................       if(h > 11) return (0b01100000 | toBCD(h - 12)); // for PM 
03AD:  MOVF   3A,W
03AE:  SUBLW  0B
03AF:  BTFSC  03.0
03B0:  GOTO   3BB
03B1:  MOVLW  0C
03B2:  SUBWF  3A,W
03B3:  MOVWF  3B
03B4:  MOVWF  3C
03B5:  CALL   201
03B6:  MOVF   78,W
03B7:  IORLW  60
03B8:  MOVWF  78
03B9:  GOTO   3C5
03BA:  GOTO   3C2
....................       else return (0b01000000 | toBCD(h)); // for AM 
03BB:  MOVF   3A,W
03BC:  MOVWF  3C
03BD:  CALL   201
03BE:  MOVF   78,W
03BF:  IORLW  40
03C0:  MOVWF  78
03C1:  GOTO   3C5
....................    } 
03C2:  GOTO   3C5
....................    else return h; // 12 hour time; Note: this does not ensure it is a valid RTC 0x02 resister BCD 
03C3:  MOVF   3A,W
03C4:  MOVWF  78
.................... } 
