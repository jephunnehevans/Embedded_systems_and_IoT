....................    ////set hour 
.................... unsigned int8 set_hour(unsigned int1 only = 1, ret = 0, unsigned int8 given = 255){ 
*
0379:  CLRF   38
.................... /*This function either returns a set/give value to a variable or writes it to the I2C RTC 0x02 resister 
.................... "ret" is a bool for retuning the set value (here, in RTC 12hour mode encoding for 0x02 resister) or not 
.................... "given" is an 8 bit binary number NOT BCD*/ 
.................... unsigned int8 v=0; 
....................    if(only) RTC_write(0x00, (0b10000000 | RTC_read(0x00))); // halting the oscilation 
037A:  MOVF   35,F
037B:  BTFSC  03.2
037C:  GOTO   386
037D:  CLRF   39
037E:  CALL   14F
037F:  MOVF   78,W
