038A:  MOVWF  3E
038B:  MOVLW  18
038C:  MOVWF  3F
038D:  CALL   1EC
038E:  MOVF   77,W
038F:  MOVWF  38
....................       if(!v) v = 24; // ensure that it is in the range of 1 to 24 (0 = 24) 
