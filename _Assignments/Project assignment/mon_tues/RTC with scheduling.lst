.................... unsigned int8 lcd_read_nibble(void); 
....................  
.................... unsigned int8 lcd_read_byte(void) 
.................... { 
....................    unsigned int8 low,high; 
....................  
....................  #if defined(__PCB__) 
....................    set_tris_lcd(LCD_INPUT_MAP); 
....................  #else 
....................   #if (defined(LCD_DATA4) && defined(LCD_DATA5) && defined(LCD_DATA6) && defined(LCD_DATA7)) 
....................    output_float(LCD_DATA4); 
*
00DE:  BSF    03.5
00DF:  BSF    06.4
....................    output_float(LCD_DATA5); 
00E0:  BSF    06.5
....................    output_float(LCD_DATA6); 
00E1:  BSF    06.6
....................    output_float(LCD_DATA7); 
00E2:  BSF    06.7
....................   #else 
....................    lcdtris.data = 0xF; 
....................   #endif 
....................  #endif 
....................          
....................    lcd_output_rw(1); 
00E3:  BCF    03.5
00E4:  BSF    06.2
....................    delay_cycles(1); 
00E5:  NOP
....................    lcd_output_enable(1); 
00E6:  BSF    06.3
....................    delay_cycles(1); 
00E7:  NOP
....................    high = lcd_read_nibble(); 
00E8:  CALL   0B3
00E9:  MOVF   78,W
00EA:  MOVWF  44
....................        
....................    lcd_output_enable(0); 
00EB:  BCF    06.3
....................    delay_cycles(1); 
00EC:  NOP
....................    lcd_output_enable(1); 
00ED:  BSF    06.3
....................    delay_us(1); 
00EE:  NOP
....................    low = lcd_read_nibble(); 
00EF:  CALL   0B3
00F0:  MOVF   78,W
00F1:  MOVWF  43
....................        
....................    lcd_output_enable(0); 
00F2:  BCF    06.3
....................  
....................  #if defined(__PCB__) 
....................    set_tris_lcd(LCD_OUTPUT_MAP); 
....................  #else 
....................   #if (defined(LCD_DATA4) && defined(LCD_DATA5) && defined(LCD_DATA6) && defined(LCD_DATA7)) 
....................    output_drive(LCD_DATA4); 
00F3:  BSF    03.5
00F4:  BCF    06.4
....................    output_drive(LCD_DATA5); 
00F5:  BCF    06.5
....................    output_drive(LCD_DATA6); 
00F6:  BCF    06.6
....................    output_drive(LCD_DATA7); 
00F7:  BCF    06.7
....................   #else 
....................    lcdtris.data = 0x0; 
....................   #endif 
....................  #endif 
....................  
....................    return( (high<<4) | low); 
00F8:  BCF    03.5
00F9:  SWAPF  44,W
00FA:  MOVWF  77
00FB:  MOVLW  F0
00FC:  ANDWF  77,F
00FD:  MOVF   77,W
00FE:  IORWF  43,W
00FF:  MOVWF  78
.................... } 
....................  
.................... unsigned int8 lcd_read_nibble(void) 
.................... { 
....................   #if (defined(LCD_DATA4) && defined(LCD_DATA5) && defined(LCD_DATA6) && defined(LCD_DATA7)) 
*
00B3:  CLRF   45
....................    unsigned int8 n = 0x00; 
....................  
....................    /* Read the data port */ 
....................    n |= input(LCD_DATA4); 
00B4:  MOVLW  00
00B5:  BTFSC  06.4
00B6:  MOVLW  01
00B7:  IORWF  45,F
....................    n |= input(LCD_DATA5) << 1; 
00B8:  MOVLW  00
00B9:  BTFSC  06.5
00BA:  MOVLW  01
00BB:  MOVWF  77
00BC:  BCF    03.0
00BD:  RLF    77,F
00BE:  MOVF   77,W
00BF:  IORWF  45,F
....................    n |= input(LCD_DATA6) << 2; 
00C0:  MOVLW  00
00C1:  BTFSC  06.6
00C2:  MOVLW  01
00C3:  MOVWF  77
00C4:  RLF    77,F
00C5:  RLF    77,F
00C6:  MOVLW  FC
00C7:  ANDWF  77,F
00C8:  MOVF   77,W
00C9:  IORWF  45,F
....................    n |= input(LCD_DATA7) << 3; 
00CA:  MOVLW  00
00CB:  BTFSC  06.7
00CC:  MOVLW  01
00CD:  MOVWF  77
00CE:  RLF    77,F
00CF:  RLF    77,F
00D0:  RLF    77,F
00D1:  MOVLW  F8
00D2:  ANDWF  77,F
00D3:  MOVF   77,W
00D4:  IORWF  45,F
....................     
....................    return(n); 
00D5:  MOVF   45,W
00D6:  MOVWF  78
....................   #else 
00D7:  RETURN
....................    return(lcd.data); 
....................   #endif 
.................... } 
....................  
.................... void lcd_send_nibble(unsigned int8 n) 
.................... { 
....................   #if (defined(LCD_DATA4) && defined(LCD_DATA5) && defined(LCD_DATA6) && defined(LCD_DATA7)) 
....................    /* Write to the data port */ 
....................    output_bit(LCD_DATA4, bit_test(n, 0)); 
*
009A:  BTFSC  44.0
009B:  GOTO   09E
009C:  BCF    06.4
009D:  GOTO   09F
009E:  BSF    06.4
....................    output_bit(LCD_DATA5, bit_test(n, 1)); 
009F:  BTFSC  44.1
00A0:  GOTO   0A3
00A1:  BCF    06.5
00A2:  GOTO   0A4
00A3:  BSF    06.5
....................    output_bit(LCD_DATA6, bit_test(n, 2)); 
00A4:  BTFSC  44.2
00A5:  GOTO   0A8
00A6:  BCF    06.6
00A7:  GOTO   0A9
00A8:  BSF    06.6
....................    output_bit(LCD_DATA7, bit_test(n, 3)); 
00A9:  BTFSC  44.3
00AA:  GOTO   0AD
00AB:  BCF    06.7
00AC:  GOTO   0AE
00AD:  BSF    06.7
....................   #else       
....................    lcdlat.data = n; 
....................   #endif 
....................        
....................    delay_cycles(1); 
00AE:  NOP
....................    lcd_output_enable(1); 
00AF:  BSF    06.3
....................    delay_us(2); 
00B0:  GOTO   0B1
....................    lcd_output_enable(0); 
00B1:  BCF    06.3
00B2:  RETURN
.................... } 
....................  
.................... void lcd_send_byte(unsigned int8 address, unsigned int8 n) 
.................... { 
....................   #if defined(__PCB__) 
....................    set_tris_lcd(LCD_OUTPUT_MAP); 
....................   #else 
....................    lcd_enable_tris(); 
*
00D8:  BSF    03.5
00D9:  BCF    06.3
....................    lcd_rs_tris(); 
00DA:  BCF    06.1
....................    lcd_rw_tris(); 
00DB:  BCF    06.2
....................   #endif 
....................  
....................    lcd_output_rs(0); 
00DC:  BCF    03.5
00DD:  BCF    06.1
....................    while ( bit_test(lcd_read_byte(),7) ) ; 
*
0100:  MOVF   78,W
0101:  MOVWF  43
0102:  BTFSC  43.7
0103:  GOTO   0DE
....................    lcd_output_rs(address); 
0104:  MOVF   41,F
0105:  BTFSS  03.2
0106:  GOTO   109
0107:  BCF    06.1
0108:  GOTO   10A
0109:  BSF    06.1
....................    delay_cycles(1); 
010A:  NOP
....................    lcd_output_rw(0); 
010B:  BCF    06.2
....................    delay_cycles(1); 
010C:  NOP
....................    lcd_output_enable(0); 
010D:  BCF    06.3
....................    lcd_send_nibble(n >> 4); 
010E:  SWAPF  42,W
010F:  MOVWF  43
0110:  MOVLW  0F
0111:  ANDWF  43,F
0112:  MOVF   43,W
0113:  MOVWF  44
0114:  CALL   09A
....................    lcd_send_nibble(n & 0xf); 
0115:  MOVF   42,W
0116:  ANDLW  0F
0117:  MOVWF  43
0118:  MOVWF  44
0119:  CALL   09A
011A:  RETURN
.................... } 
