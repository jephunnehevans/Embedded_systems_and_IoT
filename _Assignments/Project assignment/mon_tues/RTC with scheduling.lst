.................... #define Apl1 pin_c5 
.................... #define Apl2 pin_c6 
.................... #define Apl3 pin_c7 
....................  
.................... unsigned int8 apl1On[3] = {0, 6, 0}; // {min, hour, "terminator"} 24 hour mode 
*
0868:  BCF    03.5
0869:  CLRF   20
086A:  MOVLW  06
086B:  MOVWF  21
086C:  CLRF   22
.................... unsigned int8 apl1Off[3] = {0, 18, 0}; // {min, hour, "terminator"} 24 hour mode 
