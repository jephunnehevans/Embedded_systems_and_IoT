0391:  BTFSS  03.2
0392:  GOTO   395
0393:  MOVLW  18
0394:  MOVWF  38
....................       v = hoursTo12(toBCD(v)); // Since hoursTo12(v) take only valid RTC 0x02 resister BCD 
0395:  MOVF   38,W
0396:  MOVWF  3C
0397:  CALL   201
0398:  MOVF   78,W
0399:  MOVWF  39
039A:  MOVF   39,W
039B:  MOVWF  3A
*
03C5:  MOVF   78,W
03C6:  MOVWF  38
....................        
....................       if(only) RTC_write(0x00, (0b01111111 & RTC_read(0x00))); // playing the oscilation 
03C7:  MOVF   35,F
03C8:  BTFSC  03.2
03C9:  GOTO   3D3
03CA:  CLRF   39
03CB:  CALL   14F
