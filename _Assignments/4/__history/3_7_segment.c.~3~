#include <3_7_segment.h>

void main(){
   sys_init();
   while(TRUE){
      if(input(inc)){
         while(input(inc));
         counter++;
         if(counter>99)counter=99;
      }
      if(input(dec)){
         while(input(dec));
         counter--;
         if(counter<1 || counter>99)counter=0;
      }
   }
}
