void sys_init(){
   output_a(0);
   output_b(0);
   set_tris_a(0);
   set_tris_b(0b11111111);
   output_a(0);
   output_b(0);
   
   clear_interrupt(int_ext);
   enable_interrupts(int_ext);
   ext_int_edge(h_to_l);
   clear_interrupt(int_ext);
   
   clear_interrupt(int_rb);
   enable_interrupts(int_rb);
   enable_interrupts(global);
   clear_interrupt(int_rb);
}

void NO_INT(){
   switch(input_a()){
      case 1:
         while(input_a()==1);
         output_toggle(pin_b1);
         break;
      case 2:
         while(input_a()==2);
         output_toggle(pin_b2);
         break;
      case 4:
         while(input_a()==4);
         output_toggle(pin_b3);
         break;
      case 8:
         while(input_a()==8);
         output_toggle(pin_b4);
         break;
      case 16:
         while(input_a()==16);
         output_toggle(pin_b5);
            break;
         default:
            break;
         }
}
