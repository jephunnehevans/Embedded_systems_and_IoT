unsigned int8 hr=8, mn=50, sc=30, dy=4, dt=4, mt=6, yr=25;

void lcd_cls(){
   lcd_putc('\f');
}

void lcd_ln(unsigned int8 l){
   lcd_gotoxy(1, l);
}

void sys_init(){
   output_a(0); output_b(0); output_c(0);
   set_tris_b(0), set_tris_c(0b00011000);
   output_a(0); output_b(0); output_c(0);
   
   lcd_init(); lcd_cls(); lcd_ln(1);
   printf(lcd_putc "botting...");
   delay_ms(1000);
}

void data

void RTC_write(unsigned int8 hr, mn, sc, dy, dt, mt, yr, sw){
   i2c_start();
   i2c_write(0x68);
   
   i2c_write(00);
   i2c_write(sc);
   i2c_write(01);
   i2c_write(mn);
   i2c_write(02);
   i2c_write(hr);
   i2c_write(02);
   i2c_write(dy);
   i2c_write(03);
   i2c_write(dt);
   i2c_write(04);
   i2c_write(mt);
   i2c_write(05);
   i2c_write(yr);
   i2c_write(06);
   i2c_write(sw);
   i2c_write(07);
   i2c_write();
   i2c_write(08);
   
   i22c_stop();
}

