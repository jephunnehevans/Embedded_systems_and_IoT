#include <DS1307.h>

void main(){
   sys_init();
//!   lcd_cls();
//!   printf(lcd_putc "writing...");
   while(TRUE){
      lcd_cls(); lcd_ln(1);
      printf(lcd_putc "Time: %u:%u:%u", RTC_read(0x02),
      RTC_read(0x01), RTC_read(0x00));
      lcd_ln(2);
      printf(lcd_putc "Date: %u:%u:%u", RTC_read(0x04),
      RTC_read(0x05), RTC_read(0x06));
   }
}
