}

unsigned int8 toBCD(unsigned int8 num){
   return (num/10 << 4) | num%10);
}

void RTC_write(unsigned int8 addrl, char data){
   i2c_start(); //start bit
   i2c_write(0xD0); //chip address + write mode
   i2c_write(addrl); //lower 8-bits
   i2c_write(data);  //The data you want to store
   i2c_stop(); //stop bit
   delay_ms(5);
}

void sys_init(){
   output_a(0); output_b(0); output_c(0);
   set_tris_b(0), set_tris_c(0b00011000);
   output_a(0); output_b(0); output_c(0);
   
   SETUP_COUNTERS(T0_EXT_L_TO_H, T0_DIV_1);
   SET_RTCC(255);
   
   CLEAR_INTERRUPT(INT_RTCC);
   ENABLE_INTERRUPTS(INT_RTCC);
   EXT_INT_EDGE(H_TO_L);
   ENABLE_INTERRUPTS(GLOBAL);
   
   lcd_init(); lcd_cls(); lcd_ln(1);
   printf(lcd_putc "botting...");
   delay_ms(1000);
   
   RTC_write(0x00,0b00110000);
   RTC_write(0x01,0b01010000);
   RTC_write(0x02,0b00010011);
   RTC_write(0x03,0b00000100);
   RTC_write(0x04,0b00000100);
   RTC_write(0x05,0b00000110);
   RTC_write(0x06,0b00100101);
}

